# Defects4J project checkouts (~13GB, regenerate via resQ_scripts/checkout_all_defects4j.sh)

defect_projects/
resQ_outputs/defects4j_checkout_logs/
resQ_outputs/logs/

# resQ_outputs/work/ is the pipeline's per-target intermediate/build directory
# (Slicer4J instrumentation output, jar staging, debug logs) - regenerated on
# every run. Ignore the noise, keep the actual step1-4 result CSVs and
# ranking_summary.md tracked.
resQ_outputs/work/**/*.log
resQ_outputs/work/**/*.jimple
resQ_outputs/work/**/*.class
resQ_outputs/work/**/*.jar
resQ_outputs/work/**/*.pdf
resQ_outputs/work/**/*.txt
resQ_outputs/work/**/*.gz
resQ_outputs/work/**/_jar_staging/
# Slicer4J's own per-run raw result dumps (timestamped, one per criterion
# per pipeline run - e.g. result_s_2026_08_18_16_11_41.csv) - transient
# instrumentation noise, not a pipeline result artifact.
resQ_outputs/work/**/result_s_*.csv

# rq0_answerability.csv - auxiliary ground-truth-answerability classification
# (not one of the 5 core RQs), excluded from version control per request.
resQ_outputs/rq0_answerability.csv